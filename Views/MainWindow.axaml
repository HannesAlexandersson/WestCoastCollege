<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestCoastCollege.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:enums="using:WestCoastCollege.Enums"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastCollege.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Images/WCE.png"
        Title="WestCoastCollege">

    <Design.DataContext>
        <vm:MainWindowViewModel>

        </vm:MainWindowViewModel>
    </Design.DataContext>
    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, *, *">
            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="10">
                <Button Grid.Column="0"
                        Command="{Binding GoToCommand}"
                        CommandParameter="{x:Static enums:PageViewsEnum.Home}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Label FontFamily="{DynamicResource IconFont}"
                               Content="&#xe2c2;" />
                        <Label FontFamily="{DynamicResource HeaderFont}"
                               Content="Go Home" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        Margin="0 20 0 0">
                <Image Width="300" Source="/Assets/Images/best.png" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource PrimaryBgGradient}"
                Padding="10" />

        <ContentControl Grid.Row="2"
                        Padding="20"
                        Content="{Binding CurrentView}" />

    </Grid>
</Window>
