<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastCollege.ViewModels"
             xmlns:model="using:WestCoastCollege.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="WestCoastCollege.Views.ExpandedHandlerView"
             x:DataType="vm:ExpandedHandlerViewModel">
  <Design.DataContext>
    <vm:ExpandedHandlerViewModel></vm:ExpandedHandlerViewModel>
  </Design.DataContext>
  <StackPanel>
    <Grid RowDefinitions="Auto, Auto, *">


      <Grid Grid.Row="0" Margin="0,0,0,5">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Namn -->
          <StackPanel Spacing="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Handler.FirstName}" FontSize="35" />
            <TextBlock Text="{Binding Handler.LastName}" FontSize="35" />
          </StackPanel>
          <!-- ID -->
          <StackPanel Spacing="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Handler ID: " FontSize="15" />
            <TextBlock Text="{Binding Handler.PersonellId}" FontSize="15" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="5" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 10 0">
          <Button Command="{Binding $parent[UserControl].DataContext.ShowPopUpCommand}"
                  FontFamily="{DynamicResource IconFont}"
                  Content="&#xE3AE;"
                  Classes="safe" />



          <Button Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                  FontFamily="{DynamicResource IconFont}"
                  Content="&#xE4F6;"
                  Classes="danger" />
        </StackPanel>
      </Grid>


      <Border Grid.Row="1"
              BorderBrush="White"
              BorderThickness="0 0 0 2"
              Margin="0,0,0,5" />


      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="10 0">
        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="15">

          <!-- Email and phone -->
          <Grid Grid.Row="0"
                ColumnDefinitions="250, *"
                RowDefinitions="Auto, Auto, Auto, Auto"
                ColumnSpacing="10"
                RowSpacing="5">
            <TextBlock Grid.Row="0" Text="Personal information: " FontWeight="Bold"
                       FontSize="18" TextDecorations="Underline" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding Handler.Email}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone number:" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding Handler.PhoneNumber}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Date of Employment:" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding Handler.DateOfEmployment}" />
          </Grid>

          <!-- Addresses -->
          <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="Addresses: "
                       FontWeight="Bold"
                       FontSize="18"
                       TextDecorations="Underline" />
            <ItemsControl ItemsSource="{Binding Handler.Addresses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>

                  <Grid Margin="0,0,0,15"
                        ColumnDefinitions="250, *"
                        RowDefinitions="Auto, Auto, Auto"
                        ColumnSpacing="10"
                        RowSpacing="5">

                    <TextBlock Grid.Row="0" Grid.Column="0"  Text="Street name and number : " />
                    <TextBlock Grid.Row="0" Grid.Column="1"  Text="{Binding StreetAddress}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"  Text="Postal Code: " />
                    <TextBlock Grid.Row="1" Grid.Column="1"  Text="{Binding PostalCode}" />

                    <TextBlock Grid.Row="2" Grid.Column="0"  Text="City: " />
                    <TextBlock Grid.Row="2" Grid.Column="1"  Text="{Binding City}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!--Subject fields -->
          <StackPanel Grid.Row="2" Spacing="10">
            <TextBlock Text="Courses handled by Handler: "
                       FontWeight="Bold"
                       FontSize="18"
                       TextDecorations="Underline" />

            <ItemsControl ItemsSource="{Binding Handler.HandlingCourses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate  x:DataType="model:Course">

                  <Grid Margin="0,0,0,15"
                        ColumnDefinitions="250, *"
                        RowDefinitions="Auto"
                        ColumnSpacing="10"
                        RowSpacing="5">

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Course name: " />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" />

                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
    <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
      <Border Padding="30" Background="{DynamicResource WarningPopUpGradient}" BorderBrush="{DynamicResource danger}" BorderThickness="2" CornerRadius="30">

        <StackPanel MinHeight="270" MinWidth="600">
          <StackPanel Spacing="20">
            <TextBlock Padding="20" Text="This isnt possible in this prototype build" Foreground="{DynamicResource danger}" FontSize="30" />
          </StackPanel>
          <StackPanel Spacing="20" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Classes="warning" Content="OK" Padding="10" Command="{Binding ConfirmCommand}" />

          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
