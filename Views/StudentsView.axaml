<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastCollege.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="WestCoastCollege.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">
  <Design.DataContext>
    <vm:StudentsViewModel></vm:StudentsViewModel>
  </Design.DataContext>

  <Grid RowDefinitions="Auto, Auto, *">
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *">

      <Button Grid.Column="0"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddNewStudentCommand}"
              HorizontalAlignment="Left"
              Margin="10 10 0 0">
        <StackPanel Orientation="Horizontal">
          <Label FontFamily="{DynamicResource IconFont}"
                 Content="&#xE4D0;"
                 VerticalAlignment="Center"
                 FontSize="25" />
          <Label Content="Add a new student" />
        </StackPanel>
      </Button>

      <TextBlock Grid.Column="1"
                 Classes="pageTitle"
                 FontWeight="Bold"
                 TextDecorations="Underline"
                 Text="{Binding PageTitle}"
                 HorizontalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1"
            BorderBrush="{DynamicResource White-100}"
            BorderThickness="0 0 0 2"
            Padding="0 0 0 10" />

    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Margin="10 0">
      <ItemsControl ItemsSource="{Binding Students}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto, 150, 150, 300, *, 35, 35" RowSpacing="5">
              <Button Grid.Column="0"
                      Content="Expand"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToStudentCommand}"
                      CommandParameter="{Binding StudentId}"
                      />
              <Label Grid.Column="1" Content="{Binding FirstName}" />
              <Label Grid.Column="2" Content="{Binding LastName}" />
              <Label Grid.Column="3" Content="{Binding Email}" />

              <Button Grid.Column="5"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToEditStudentCommand}"
                      CommandParameter="{Binding StudentId}"
                      FontFamily="{DynamicResource IconFont}"
                      Content="&#xE3AE;"
                      Classes="safe"
                      HorizontalAlignment="Left" />
              <Button Grid.Column="6"
                      Command="{Binding $parent[UserControl].DataContext.ShowPopUpCommand}"
                      CommandParameter="{Binding StudentId}"
                      FontFamily="{DynamicResource IconFont}"
                      Content="&#xE4F6;"
                      Classes="danger"
                      HorizontalAlignment="Left" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
      <Border Padding="30" Background="{DynamicResource WarningPopUpGradient}" BorderBrush="{DynamicResource White-100}" BorderThickness="2" CornerRadius="30">
        <StackPanel>
          <StackPanel Spacing="20">
            <TextBlock Padding="20" Text="Are you sure you want to delete this student?" Foreground="{DynamicResource danger}" FontSize="30" />
          </StackPanel>
          <StackPanel Spacing="20" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Classes="Warning" Content="Abort" Command="{Binding AbortCommand}" />
            <Button Classes="Warning" Content="OK" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
