<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastCollege.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastCollege.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">
  <Design.DataContext>
    <vm:StudentsViewModel></vm:StudentsViewModel>
  </Design.DataContext>
  <ScrollViewer MaxHeight="500">
    <StackPanel Spacing="10" >
      <TextBlock Classes="pageTitle" FontWeight="Bold" TextDecorations="Underline" Text="{Binding PageTitle}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
