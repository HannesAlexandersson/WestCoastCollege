<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastCollege.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastCollege.Views.HomeView"
             x:DataType="vm:HomeViewModel">
      <StackPanel Spacing="20" Margin="15">

            <!-- First row: three buttons -->
            <Grid ColumnDefinitions="Auto, Auto, Auto"
                  ColumnSpacing="20"
                  HorizontalAlignment="Center">

                  <Button Grid.Column="0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xe2c2;" />
                              <Label Content="Students" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xe964;" />
                              <Label Content="Teachers" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE390;" />
                              <Label Content="Courses" />
                        </StackPanel>
                  </Button>

            </Grid>

            <!-- Second row: two centered buttons -->
            <Grid ColumnDefinitions="Auto, Auto"
                  ColumnSpacing="20"
                  HorizontalAlignment="Center">

                  <Button Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE6F8;" />
                              <Label Content="Admins" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE6F8;" />
                              <Label Content="Handlers" />
                        </StackPanel>
                  </Button>

            </Grid>

      </StackPanel>
</UserControl>