<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="using:WestCoastCollege.Enums"
             xmlns:vm="using:WestCoastCollege.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastCollege.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             >
      <Design.DataContext>
            <vm:HomeViewModel></vm:HomeViewModel>
      </Design.DataContext>
      <StackPanel Spacing="20" Margin="15">

            <Grid ColumnDefinitions="Auto, Auto, Auto"
                  ColumnSpacing="20"
                  HorizontalAlignment="Center">

                  <Button Grid.Column="0"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{x:Static enums:PageViewsEnum.Teachers}"
                          >

                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE73E;" />
                              <Label Content="Students" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="1"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{x:Static enums:PageViewsEnum.Teachers}" >
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE600;" />
                              <Label Content="Teachers" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="2" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{x:Static enums:PageViewsEnum.Courses}" >
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE758;" />
                              <Label Content="Courses" />
                        </StackPanel>
                  </Button>

            </Grid>


            <Grid ColumnDefinitions="Auto, Auto"
                  ColumnSpacing="20"
                  HorizontalAlignment="Center">

                  <Button Grid.Column="0" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                          CommandParameter="{x:Static enums:PageViewsEnum.Admins}" >
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE198;" />
                              <Label Content="Admins" />
                        </StackPanel>
                  </Button>

                  <Button Grid.Column="1" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}" CommandParameter="{x:Static enums:PageViewsEnum.Handlers}" >
                        <StackPanel Orientation="Horizontal">
                              <Label FontFamily="{DynamicResource IconFont}"
                                     Content="&#xE6F8;" />
                              <Label Content="Handlers" />
                        </StackPanel>
                  </Button>

            </Grid>
      </StackPanel>
</UserControl>