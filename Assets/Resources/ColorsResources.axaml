<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
  <Color x:Key="White-100" >#FFF</Color>
  <Color x:Key="White-500" >#FFF0EFEF</Color>
  <Color x:Key="Black-100" >#000</Color>
  <Color x:Key="PrimaryTextColor" >#eae8e8</Color>
  <Color x:Key="SecondaryTextColor">#2B0841</Color>
  <Color x:Key="PrimaryBgColor" >#2B0841</Color>
  <Color x:Key="SecondaryBgColor" >#48088C</Color>
  <Color x:Key="BtnBgClr" >#4F2472</Color>
  <Color x:Key="BorderColor" >#FF00FF</Color>
  <Color x:Key="PrimaryDanger">#FFFB0303</Color>
  <Color x:Key="PrimarySafe">#03C303</Color>
  <Color x:Key="WarningColor">#F45906</Color>
</ResourceDictionary>
