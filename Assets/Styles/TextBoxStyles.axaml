<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>

    <!--A BETTER NAME FOR THIS FILE WOULD BE FORMSTYLES-->
    <Border Padding="20" Height="500">

      <!-- Add Controls for Previewer Here -->
      <StackPanel Spacing="15">
        <!--   <CalendarDatePicker Width="300"
        ></CalendarDatePicker> -->
        <TextBox Width="200"
                 Text="NameOfSubject"
                 />
      </StackPanel>

      <!--  <ComboBox IsDropDownOpen="True"
      Width="300">
      <ComboBoxItem Classes="TextBlock.dropdown">Hej</ComboBoxItem>
      <ComboBoxItem>Another course</ComboBoxItem>
      <ComboBoxItem>Third course</ComboBoxItem>
      </ComboBox> -->
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
  <Style Selector="TextBox">
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="Background" Value="#C5EDC6E5" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="PlaceholderText" Value="Write here" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="Background" Value="#C5EDC6E5" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="#C54E1994" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />

  </Style>

  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimaryBgColor}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
  </Style>

  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource PrimaryBgColor}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
  </Style>

  <Style Selector="CalendarDatePicker">
    <Setter Property="MinWidth" Value="300" />
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="Background" Value="#C5EDC6E5" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="CalendarDatePicker Calendar">
    <Setter Property="Background" Value="#C5EDC6E5" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
  </Style>
  <Style Selector="CalendarDatePicker TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
  </Style>
</Styles>
