<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <!-- Add Controls for Previewer Here -->
    <Border Padding="30" Background="{DynamicResource PrimaryPopUpGradient}" BorderBrush="Orange" BorderThickness="2" CornerRadius="30">

      <StackPanel>
        <StackPanel Spacing="20">
          <TextBlock Padding="20" Text="Are you sure you want to add this course?" Foreground="{DynamicResource danger}" FontSize="30" />
        </StackPanel>
        <StackPanel Spacing="20" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Classes="Warning" Content="Abort"/>
          <Button Classes="Warning" Content="OK" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
  </Style>
</Styles>
